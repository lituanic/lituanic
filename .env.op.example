# 1Password secret references (used with: op run --env-file=.env.op -- bun start)
# Copy to .env.op and update vault/item names to match your 1Password setup.

# Required — Claude API
ANTHROPIC_API_KEY=op://YourVault/Claude/api-key

# Required — Slack (Socket Mode)
SLACK_BOT_TOKEN=op://YourVault/Slack Bot/bot-token
SLACK_APP_TOKEN=op://YourVault/Slack Bot/app-token

# Linear
LINEAR_API_KEY=op://YourVault/Linear/LINEAR_API_TOKEN

# Linear webhook (for HMAC verification)
LINEAR_WEBHOOK_SECRET=op://YourVault/Linear Webhook/LINEAR_SIGNING_SECRET

# GitHub
GH_TOKEN=op://YourVault/GitHub/token

# Google Workspace
GWS_CLIENT_ID=op://YourVault/GWS Credentials/client-id
GWS_CLIENT_SECRET=op://YourVault/GWS Credentials/client-secret
GWS_REFRESH_TOKEN=op://YourVault/GWS Credentials/refresh-token
GWS_PROJECT_ID=op://YourVault/GWS Credentials/project-id

# Vercel
VERCEL_TOKEN=op://YourVault/Vercel/LAUPIX_VERCEL_TOKEN

# Resend (email)
RESEND_API_KEY=op://YourVault/Resend/api-key
EMAIL_FROM=op://YourVault/Resend/email-from

# Typefully (X/Twitter posting)
TYPEFULLY_API_KEY=op://YourVault/Typefully/TYPEFULLY_API_KEY

# Kernel (cloud browser)
KERNEL_API_KEY=op://YourVault/Kernel/KERNEL_API_KEY

# DataForSEO
DATAFORSEO_LOGIN=op://YourVault/DataForSEO/email
DATAFORSEO_PASSWORD=op://YourVault/DataForSEO/DATAFORSEO_API_KEY

# ScreenshotOne
SCREENSHOTONE_ACCESS_KEY=op://YourVault/ScreenshotOne/SCREENSHOTONE_ACCESS_KEY
SCREENSHOTONE_SECRET_KEY=op://YourVault/ScreenshotOne/SCREENSHOTONE_SECRET_KEY

# Payload CMS
PAYLOAD_CMS_EMAIL=op://YourVault/Payload CMS/PAYLOAD_CMS_EMAIL
PAYLOAD_CMS_PASSWORD=op://YourVault/Payload CMS/PAYLOAD_CMS_PASSWORD

# Unsplash
UNSPLASH_ACCESS_KEY=op://YourVault/Unsplash/UNSPLASH_ACCESS_KEY

# Product Hunt
PRODUCTHUNT_API_TOKEN=op://YourVault/Product Hunt/PRODUCTHUNT_API_TOKEN
