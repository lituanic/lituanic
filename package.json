{
  "name": "lituanic",
  "version": "0.1.7",
  "description": "AI coworker for solo founders. Picks up Linear issues, writes code, sends email, and reports back to Slack.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "bin": {
    "lituanic": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/__tests__",
    ".claude",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun --watch run src/cli.ts",
    "lint": "bunx tsc --noEmit",
    "test": "bun test",
    "build": "tsc"
  },
  "keywords": [
    "agent",
    "ai",
    "claude",
    "slack",
    "autonomous",
    "daemon"
  ],
  "author": "Tomas Laurinavicius",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lituanic/lituanic.git"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://lituanic.com",
  "trustedDependencies": [],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.77",
    "@slack/bolt": "^4.2.0",
    "croner": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
